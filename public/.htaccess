# fnrc — Apache config for shared hosting. Vite copies this into dist/, so a
# build-and-deploy publishes it at the docroot automatically.

# /api/token is what the widget posts to; token.php is what answers it.
RewriteEngine On
RewriteRule ^api/token/?$ /api/token.php [L]

# Single-page site: anything that isn't a real file falls back to index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Belt and braces — the secrets file belongs above public_html, but if it ever
# lands inside it, refuse to serve it.
<FilesMatch "^(fnrc-secrets\.php|\.env|\.ht.*)$">
  Require all denied
</FilesMatch>

# Hashed build assets never change under their own name, so cache them hard.
# Matching the filename (Vite's `index-a1b2c3d4.js`) rather than the MIME type,
# because hosts disagree on whether .js is text/javascript or
# application/javascript — and an unhashed file like logo.png must not match.
<IfModule mod_headers.c>
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached, or a deploy leaves browsers asking for
  # asset names that no longer exist.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
