# Server-side only. Read by the Vite dev server and by server/index.mjs;
# they never reach the browser.
# Never prefix them with VITE_ — that would publish the secret in the bundle.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Optional, server-side
# PORT=8787
# CORS_ORIGIN=https://portal.example.gov.ae

# Optional, client-side: point the widget at a token endpoint other than /api/token
# VITE_FNRC_TOKEN_ENDPOINT=https://api.example.gov.ae/token
